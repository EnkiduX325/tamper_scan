# 统一换行符：仓库内文本文件使用 LF，Windows 批处理保留 CRLF
* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.txt text eol=lf
*.yar text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制资源
*.png binary
*.ico binary
*.exe binary
*.dll binary
*.zip binary
*.pyd binary
